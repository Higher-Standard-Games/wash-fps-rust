#!/bin/sh
# The AppImage's entry point (tools/package.sh). The game links the system's
# ALSA rather than carrying it; when it is missing the loader fails before
# the game can say anything, so this names the package to install instead.
here=$(dirname "$(readlink -f "$0")")
bin="$here/usr/bin/washoi"
if command -v ldd >/dev/null 2>&1; then
  missing=$(ldd "$bin" 2>/dev/null | awk '/not found/ { print $1 }')
  if [ -n "$missing" ]; then
    text="Washoi needs system libraries that are not installed:

$missing

Install ALSA with your package manager:
  Arch, Manjaro        sudo pacman -S alsa-lib
  Debian, Ubuntu       sudo apt install libasound2
  Fedora               sudo dnf install alsa-lib
  openSUSE             sudo zypper install alsa"
    echo "$text" >&2
    if [ ! -t 2 ]; then
      if command -v zenity >/dev/null 2>&1; then
        zenity --error --title=Washoi --no-wrap --text="$text" 2>/dev/null
      elif command -v kdialog >/dev/null 2>&1; then
        kdialog --title Washoi --error "$text" 2>/dev/null
      elif command -v notify-send >/dev/null 2>&1; then
        notify-send Washoi "$text" 2>/dev/null
      fi
    fi
    exit 127
  fi
fi
exec "$bin" "$@"
